# pyenv
#   For a library or package, you might want to ignore these files since the Python version
#   is elected by the tool chain. In that case, uncomment the following entities.
# .python-version

# pipenv
#   According to pypa/pipenv#1185, pipenv uses the runtime_library_dir to
#   store its virtualenv. We should exclude it from source control.
.venv/
runtime_library_dir/

# Poetry
#   Poetry uses pyproject.toml to manage dependencies and virtualenv.
#   It's recommended to include poetry.lock in source control.
# poetry.lock

# pdm
#   Poetry uses pyproject.toml to manage dependencies and virtualenv.
#   It's recommended to include pdm.lock in source control.
# pdm.lock

# PEP 582; used by e.g. github.com/pdm-project/pdm
__pypackages__/

